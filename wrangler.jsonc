{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "morn-issue-bridge",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-01",
  "vars": {
    "DROP_ORIGIN": ""
  },
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "REPORTS_DB",
      "database_name": "morn-issue-reports",
      "migrations_dir": "migrations"
    }
  ]
}
